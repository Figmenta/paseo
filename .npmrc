# Figmenta fork: npm >= 11.16 blocks package install scripts by default, and this repo
# cannot be installed without them — electron's postinstall downloads the runtime binary,
# node-pty and sharp build their native addons, esbuild fetches its platform binary.
# The list is explicit on purpose: no --dangerously-allow-all-scripts.
allow-scripts=electron,node-pty,esbuild,sharp,fsevents
allow-scripts-pin=false
